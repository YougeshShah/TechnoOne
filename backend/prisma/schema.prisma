// ============================================================
// NyayaOne — Prisma Schema
// Multi-Tenant Legal Technology Platform (Phase 1 - MVP)
// Owner: TrailBlaze Tech
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

// Top-level account type. Determines which "world" a user belongs to.
// NOTE: these names date back to when this platform served law firms
// only. An EDUCATION-type tenant (an IELTS/coaching institute, see
// TenantType below) reuses the exact same values -- LAW_FIRM_ADMIN is that
// institution's admin, LAWYER/STAFF are its teachers/general staff. Do not
// assume any of these names imply an actual law firm; check tenantType.
enum AccountType {
  COMPANY // TrailBlaze Tech staff (Super Admin, Library Manager, etc.)
  LAW_FIRM_ADMIN // Owner/Admin of a tenant -- a law firm OR an education institute
  LAWYER // A tenant's teacher/senior staff (law firm: lawyer; institute: teacher)
  STAFF // A tenant's general/support staff (law firm: receptionist/assistant/intern; institute: general staff)
  CLIENT
  STUDENT // Phase 2 — Student Learning Platform (self-registered, no law firm)
}

// What kind of business this tenant is — drives which modules make sense
// for them and how their staff roles/dashboard should be labeled.
enum TenantType {
  LAW_FIRM
  EDUCATION
  OTHER
}

enum LawFirmStatus {
  PENDING // awaiting company approval
  ACTIVE
  SUSPENDED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum CaseStatus {
  OPEN
  ONGOING
  ON_HOLD
  CLOSED
  DISMISSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  ADJOURNED
  CANCELLED
}

enum DocumentCategory {
  CASE_FILING
  EVIDENCE
  COURT_ORDER
  AGREEMENT
  CORRESPONDENCE
  IDENTIFICATION
  OTHER
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationAudience {
  ALL_LAWYERS
  SPECIFIC_LAW_FIRM
  ALL_STUDENTS
  ALL_CLIENTS
  INDIVIDUAL_USER
  INSTITUTION_STUDENTS
  ALL_INSTITUTION_ADMINS
  CASE_DEADLINE
}

enum LibraryResourceType {
  CONSTITUTION
  ACT
  ORDINANCE // अध्यादेश — was missing entirely before
  REGULATION // नियमावली
  RULE // नियम
  FORMATION_ORDER // (गठन) आदेश — was missing
  POLICY // नीति — was missing
  INTERNATIONAL_TREATY // अन्तर्राष्ट्रिय सन्धि सम्झौता — was missing
  HISTORICAL_DOCUMENT // ऐतिहासिक दस्तावेज — was missing
  ANNUAL_REPORT // बार्षिक प्रतिवेदन — was missing
  RTI_DISCLOSURE // सूचनाको हक बमोजिम सार्वजनिक गरिएको — was missing
  CIRCULAR
  GOVERNMENT_NOTICE
  GAZETTE
  SUPREME_COURT_DECISION
  HIGH_COURT_DECISION
  ARTICLE
  RESEARCH_PAPER
  JOURNAL
  TEMPLATE
  LEGAL_FORM
  NOTE // Phase 2 — student study notes
  CASE_SUMMARY // Phase 2 — condensed case summaries for exam prep
  BOOK // Phase 2 — textbooks/reference books
}

// ------------------------------------------------------------
// COMPANY (TrailBlaze Tech) — Platform Owner
// ------------------------------------------------------------

// Roles come in two kinds, distinguished by lawFirmId:
//   - lawFirmId = null  → platform-level role (Super Admin, Content Manager, ...)
//     used by Company staff, managed via /admin/roles (Super Admin only)
//   - lawFirmId = set   → tenant-scoped custom role, created by that tenant's
//     own Admin (a Law Firm's "Senior Associate" or an Institute's "Teacher"),
//     visible and usable ONLY within that tenant
model Role {
  id          String   @id @default(uuid())
  name        String // e.g. "Super Admin", "Library Manager", or a tenant's own "Teacher"
  description String?
  isSystem    Boolean  @default(false) // true = built-in role, cannot be deleted
  lawFirmId   String? // null = platform-level Company role; set = this tenant's own role
  lawFirm     LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, lawFirmId])
  @@index([lawFirmId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "lawfirm.approve", "case.view.own"
  description String?
  module      String // e.g. "LawFirm", "Case", "Library"
  roles       RolePermission[]
  userOverrides UserPermission[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([roleId, permissionId])
}

// ------------------------------------------------------------
// LAW FIRM (Tenant)
// ------------------------------------------------------------

// Despite the name "LawFirm" (kept as-is to avoid a breaking rename across
// every module that already references it — User.lawFirmId, Case.lawFirmId,
// etc.), this is now the generic TENANT record. `tenantType` and
// `modulesEnabled` are what make it usable for a Law Firm, an Education
// company, or any future client type without a schema rename.
model LawFirm {
  id              String        @id @default(uuid())
  name            String
  // URL-safe unique identifier for this institution's own entry point
  // (e.g. "raju-law-institute") -- used for subdomain-based routing once
  // deployed (raju-law-institute.nyayaone.com), and via a "?org=" query
  // param during local development before real subdomains are set up.
  // A student registering through THIS institution's specific entry point
  // is automatically tied to it (not visible to/approvable by any other
  // institution).
  slug            String?       @unique
  registrationNo  String?       @unique
  status          LawFirmStatus @default(PENDING)
  address         String?
  phone           String?
  email           String?       @unique
  approvedAt      DateTime?
  approvedBy      String? // User id of company staff who approved

  tenantType      TenantType    @default(LAW_FIRM)
  supportTickets  SupportTicket[]
  modulesEnabled  String[]      @default(["case_management"]) // e.g. ["case_management"], ["student_platform", "live_classes"]
  // For Education tenants — which course(s)/sectors this institution is
  // allowed to teach (e.g. only IELTS, or only Law). An institute that only
  // teaches IELTS should never see or add content to the Law course, even
  // though student_platform is enabled. Empty array = no restriction yet
  // set by Company (institution setup incomplete).
  allowedCourseIds String[]     @default([])

  // Finer-grained than allowedCourseIds — restricts WHICH exam level/track
  // within an allowed course this institution may access (e.g. a Loksewa
  // institute that only coaches for Kharidar shouldn't see Section Officer
  // content). Empty array = no restriction (all levels within their
  // allowed courses).
  allowedExamTypes String[]     @default([])

  // Whether students at this institution may screenshot/screen-record a
  // Live Class recording during playback. Blocked by default -- an
  // institution must explicitly opt in for their own students.
  allowRecordingScreenshots Boolean @default(false)

  users           User[]
  clients         Client[]
  cases           Case[]
  documents       Document[]
  documentRequests DocumentRequest[]
  subscription    FirmSubscription?
  roles           Role[] // this tenant's own custom staff roles
  hostedLiveClasses LiveClass[] // classes this institution's own staff scheduled
  hostedLibraryResources LibraryResource[] // resources this institution's own staff uploaded
  hostedMcqQuestions McqQuestion[] // MCQs this institution's own staff wrote
  usageLimits     UsageLimit[]
  invoices        Invoice[]
  courseFees      CourseFee[]
  courseContents  CourseContent[]
  firmPaymentTransactions FirmPaymentTransaction[]
  paymentQrCodeUrl String? // uploaded QR code image (bank/wallet) students scan to pay this institution directly
  websiteHtml      String? // full self-contained HTML for this firm/institution's public marketing page, edited by Company on their behalf, served at their own subdomain
  staffSalaries   StaffSalary[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([tenantType])
}

// ------------------------------------------------------------
// USER (Company Staff, Lawyer, Firm Staff, Client)
// ------------------------------------------------------------

model User {
  id            String       @id @default(uuid())
  accountType   AccountType
  fullName      String
  email         String // unique per-organization only, see @@unique below
  phone         String? // unique per-organization only, see @@unique below
  avatarUrl     String?
  passwordHash  String
  status        UserStatus   @default(PENDING_VERIFICATION)

  // Multi-tenant scoping. Null for COMPANY accounts.
  lawFirm       LawFirm?     @relation(fields: [lawFirmId], references: [id])
  lawFirmId     String?

  // RBAC — used mainly for COMPANY accounts with custom roles.
  role          Role?        @relation(fields: [roleId], references: [id])
  roleId        String?
  individualPermissions UserPermission[]
  conversationsAsUserA Conversation[] @relation("ConversationAsUserA")
  conversationsAsUserB Conversation[] @relation("ConversationAsUserB")
  sentMessages         Message[]      @relation("MessageSender")
  ticketsCreated       SupportTicket[] @relation("TicketCreatedBy")
  ticketComments       TicketComment[] @relation("TicketCommentAuthor")

  // Student-only — captured at registration ("what are you preparing
  // for?"), used purely to personalize the dashboard on first login.
  // Nullable and unenforced — never gates access to any course.
  preferredCourseId String?

  // For institution-added students of a multi-level course (e.g. Loksewa):
  // which specific level/track (Kharidar, Nayab Subba, Section Officer,
  // etc.) this student is preparing for. Nullable — self-registered
  // students and institutions that don't need level-splitting leave this
  // unset, seeing all content within their allowed courses as before.
  preferredExamType String?

  // Lawyer-specific professional details
  barRegistrationNo String?
  specialization    String?

  // Expo push notification token — registered from the mobile app after login.
  pushToken     String?

  // Relations
  casesAsLawyer     CaseLawyer[]
  hearingsCreated   Hearing[]        @relation("HearingCreatedBy")
  documentsUploaded Document[]       @relation("DocumentUploadedBy")
  documentRequestsMade DocumentRequest[] @relation("DocumentRequestedBy")
  clientProfile     Client?          @relation("ClientUserLink")
  notifications     UserNotification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  // Phase 2 — Student Learning Platform relations
  testAttempts       TestAttempt[]         @relation("StudentTestAttempts")
  bookmarks          Bookmark[]            @relation("StudentBookmarks")
  studyProgress      StudyProgress[]       @relation("StudentProgress")
  courseSubscriptions CourseSubscription[] @relation("StudentCourseSubscriptions")
  paymentVouchers     PaymentVoucher[]       @relation("StudentPaymentVouchers")
  ownNotes            StudentNote[]          @relation("StudentOwnNotes")
  caseNotesWritten    CaseNote[]             @relation("CaseNoteAuthor")
  caseTasksAssigned   CaseTask[]             @relation("CaseTaskAssignee")
  liveClassAttendance LiveClassAttendance[] @relation("StudentLiveClassAttendance")
  writingSubmissions  WritingSubmission[]  @relation("StudentWritingSubmissions")
  feedbackGiven       Feedback[]           @relation("StudentFeedback")
  payments            PaymentTransaction[] @relation("StudentPayments")
  speakingSubmissions SpeakingSubmission[]
  practiceSessions PracticeSession[]
  liveClassHostings LiveClassHost[]
  studentDiscounts StudentDiscount[] @relation("StudentDiscounts")
  staffSalaryRecords StaffSalary[] @relation("StaffSalaryRecord")
  emailVerified Boolean @default(false)
  bio           String? // short "About" text shown on the profile page
  lastLoginAt   DateTime? // set on each successful login -- shown on profile for security awareness
  mustChangePassword Boolean @default(false) // true when this account was created by Company/Institution with a temporary password -- forces a password change on first login before anything else is usable
  notificationsEnabled Boolean @default(true) // push notification preference, toggled from mobile app settings

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([email, lawFirmId])
  @@unique([phone, lawFirmId])
  @@index([lawFirmId])
  @@index([accountType])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------
// CLIENT (belongs to a Law Firm; may optionally have login access)
// ------------------------------------------------------------

model Client {
  id             String   @id @default(uuid())
  lawFirm        LawFirm  @relation(fields: [lawFirmId], references: [id])
  lawFirmId      String

  // Optional linked login account (Client Mobile App access)
  user           User?    @relation("ClientUserLink", fields: [userId], references: [id])
  userId         String?  @unique

  fullName       String
  fullNameNepali String? // Devanagari-script name — used in generated legal documents when present, falls back to fullName otherwise
  phone          String?
  email          String?
  address        String?
  identificationType String? // Citizenship, Passport, etc.
  identificationNo   String?
  notes          String?

  cases          CaseClient[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lawFirmId])
}

// ------------------------------------------------------------
// COURT (managed only by Company / TrailBlaze Tech)
// ------------------------------------------------------------

model Court {
  id         String   @id @default(uuid())
  name       String // e.g. "Kathmandu District Court"
  nepaliName String? // e.g. "काठमाडौं जिल्ला अदालत" — shown when Nepali is selected, falls back to name
  type       String // e.g. "Supreme Court", "High Court", "District Court" — extensible, not enum
  province   String? // e.g. "Bagmati", "Koshi" — null for national-level courts (Supreme Court, national tribunals)
  location   String?
  isActive   Boolean  @default(true)

  cases      Case[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type])
  @@index([province])
}

// ------------------------------------------------------------
// CASE
// ------------------------------------------------------------

model Case {
  id              String       @id @default(uuid())
  lawFirm         LawFirm      @relation(fields: [lawFirmId], references: [id])
  lawFirmId       String

  caseNumber      String
  caseTitle       String
  court           Court        @relation(fields: [courtId], references: [id])
  courtId         String

  opposingParty   String?
  opposingLawyer  String?
  courtSubject    String?
  category        String?
  filingDate      DateTime?
  judge           String?

  status          CaseStatus   @default(OPEN)
  priority        CasePriority @default(MEDIUM)
  remarks         String?

  clients         CaseClient[]
  lawyers         CaseLawyer[]
  hearings        Hearing[]
  documents       Document[]
  documentRequests DocumentRequest[]
  notes           CaseNote[]
  deadlines       CaseDeadline[]
  tasks           CaseTask[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([lawFirmId, caseNumber])
  @@index([lawFirmId, status])
}

// Many-to-many: a case can have multiple clients, a client can have multiple cases
model CaseClient {
  id       String @id @default(uuid())
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@unique([caseId, clientId])
}

// Many-to-many: a case can have multiple lawyers assigned (lead + associates)
model CaseLawyer {
  id       String  @id @default(uuid())
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  lawyer   User    @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId String
  isLead   Boolean @default(false)

  @@unique([caseId, lawyerId])
}

// ------------------------------------------------------------
// HEARING (with automatic reminder scheduling)
// ------------------------------------------------------------

model Hearing {
  id            String        @id @default(uuid())
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String

  hearingDate   DateTime
  courtName     String?
  judge         String?
  remarks       String?
  status        HearingStatus @default(SCHEDULED)
  nextHearingId String?       @unique
  nextHearing   Hearing?      @relation("HearingChain", fields: [nextHearingId], references: [id])
  previousHearing Hearing?    @relation("HearingChain")

  createdBy     User          @relation("HearingCreatedBy", fields: [createdById], references: [id])
  createdById   String

  reminders     HearingReminder[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([caseId])
  @@index([hearingDate])
}

// System-generated reminders. Created automatically by backend, never by the lawyer manually.
model HearingReminder {
  id           String   @id @default(uuid())
  hearing      Hearing  @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  hearingId    String
  remindAt     DateTime // computed: 48h/24h/day-of/2h before hearingDate
  label        String // "48_HOURS_BEFORE" | "24_HOURS_BEFORE" | "HEARING_DAY" | "2_HOURS_BEFORE"
  sent         Boolean  @default(false)
  sentAt       DateTime?

  createdAt    DateTime @default(now())

  @@index([remindAt, sent])
}

// ------------------------------------------------------------
// DOCUMENT
// ------------------------------------------------------------

model Document {
  id           String           @id @default(uuid())
  lawFirm      LawFirm          @relation(fields: [lawFirmId], references: [id])
  lawFirmId    String

  case         Case?            @relation(fields: [caseId], references: [id])
  caseId       String?

  fileName     String
  fileUrl      String // storage-driver-agnostic path/url
  fileType     String // pdf, image, docx
  fileSizeKb   Int?
  category     DocumentCategory @default(OTHER)
  // Lawyer-controlled: whether the client on this case can see this
  // document in their portal. Defaults true for lawyer uploads (most
  // shared documents are meant for the client); set explicitly false for
  // internal-only files. Documents the CLIENT themselves uploaded are
  // always visible to them regardless of this flag.
  visibleToClient Boolean        @default(true)

  uploadedBy   User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  createdAt    DateTime         @default(now())

  fulfilledByRequest DocumentRequest?

  @@index([lawFirmId])
  @@index([caseId])
}

enum DocumentRequestStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// A lawyer/staff asking a client to upload a specific document (e.g.
// "Property Deed copy") -- separate from Document itself so the client
// sees a clear checklist of what's still owed, not just a raw upload button.
model DocumentRequest {
  id                  String                 @id @default(uuid())
  lawFirm             LawFirm                @relation(fields: [lawFirmId], references: [id])
  lawFirmId           String

  case                Case                   @relation(fields: [caseId], references: [id])
  caseId              String

  title               String // e.g. "Property Deed Copy"
  description         String?
  status              DocumentRequestStatus  @default(PENDING)

  requestedBy         User                   @relation("DocumentRequestedBy", fields: [requestedById], references: [id])
  requestedById        String

  fulfilledDocument    Document?             @relation(fields: [fulfilledDocumentId], references: [id])
  fulfilledDocumentId  String?               @unique

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([lawFirmId])
  @@index([caseId])
  @@index([status])
}

// ------------------------------------------------------------
// LEGAL LIBRARY (Company-managed only)
// ------------------------------------------------------------

model LibraryResource {
  id          String              @id @default(uuid())
  title       String
  type        LibraryResourceType
  category    String? // free-text subcategory, e.g. "हालसालैका ऐन", "खण्ड अनुसार", "वर्णानुक्रम अनुसारको सूची"
  isRepealed  Boolean             @default(false) // खारेज भएको — Law Commission marks existing law as repealed rather than using a separate type
  actName     String?
  section     String?
  chapter     String?
  keywords    String[] // for search
  fileUrl     String?
  content     String? // extracted text (from PDF or typed article) — searched for full-text search inside documents
  isDownloadable Boolean          @default(true)

  // Phase 2 — Student Learning Platform filters. Nullable/optional so this
  // stays a no-op for existing lawyer-facing library resources; only content
  // tagged for student use populates these.
  subjectId   String?
  subject     Subject?            @relation(fields: [subjectId], references: [id])
  examType    ExamType?
  difficulty  Difficulty?
  isFreeDemo  Boolean             @default(false) // accessible without a course subscription
  // Null = published by TrailBlaze (Company), visible to all subscribers of
  // the linked course. Set = uploaded by a specific institution's own
  // staff — only that institution's own students can see it.
  hostLawFirmId String?
  hostLawFirm    LawFirm?         @relation(fields: [hostLawFirmId], references: [id])

  publishedBy String // User id of company content manager
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type])
  @@index([category])
  @@index([isRepealed])
  @@index([subjectId])
  @@index([examType])
}

// ------------------------------------------------------------
// NOTIFICATIONS (Company announcements + system notifications)
// ------------------------------------------------------------

model Notification {
  id         String                 @id @default(uuid())
  title      String
  body       String
  audience   NotificationAudience
  targetId   String? // lawFirmId or userId depending on audience
  channel    NotificationChannel    @default(IN_APP)

  createdBy  String // User id (company staff)
  createdAt  DateTime               @default(now())

  recipients UserNotification[]
}

// Join table tracking per-user read/delivery state
model UserNotification {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  isRead         Boolean      @default(false)
  readAt         DateTime?
  deliveredAt    DateTime?

  createdAt      DateTime     @default(now())

  @@unique([userId, notificationId])
  @@index([userId, isRead])
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String // e.g. "LAW_FIRM_APPROVED", "CASE_CREATED"
  entityType String // e.g. "LawFirm", "Case"
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ------------------------------------------------------------
// DOCUMENT TEMPLATES (auto-fill from case/client data)
// Company manages the master templates (e.g. "Marriage Registration
// Application", "Power of Attorney"). A lawyer picks a template + a case,
// and the system fills in {{placeholders}} from that case's real data —
// so the lawyer never retypes the same boilerplate by hand.
// ------------------------------------------------------------

model DocumentTemplate {
  id           String   @id @default(uuid())
  title        String
  category     String? // e.g. "Family Law", "Property", "Criminal"
  description  String?
  bodyTemplate String // free text with {{fieldKey}} placeholders
  // Dynamic form definition — an array of field objects, e.g.:
  // [{ "key": "petitionerName", "label": "Petitioner's Name", "type": "text",
  //    "autoFillSource": "client.fullName", "required": true }, ...]
  // autoFillSource is optional — omit it for fields the lawyer must type manually.
  // See document-template.service.ts for the full list of supported autoFillSource paths.
  fields       Json?
  isActive     Boolean  @default(true)

  createdBy    String // User id (Company staff)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
// NOTE: This models plan definitions and firm-plan assignment only.
// Actual payment gateway processing (eSewa/Khalti/card) is NOT included —
// that requires real merchant credentials and is handled outside this schema.
// A Company staff member manually marks a subscription ACTIVE after
// confirming payment through whatever channel the firm used.
// ------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id            String    @id @default(uuid())
  name          String    @unique // "Free", "Basic", "Professional", "Enterprise"
  description   String?
  priceMonthly  Int? // NPR, stored as whole rupees; null = custom/contact-us pricing (Enterprise)
  maxLawyers    Int? // null = unlimited
  maxCases      Int? // null = unlimited
  maxStorageMb  Int? // null = unlimited
  isActive      Boolean   @default(true)
  durationMonths Int?     @default(1) // billing cycle length -- 1, 3, 6, 12. null = lifetime/no-expiry (e.g. a permanent free tier)
  tenantType    String?   // "LAW_FIRM" | "EDUCATION" | null = available to both

  subscriptions FirmSubscription[]
  firmPaymentTransactions FirmPaymentTransaction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FirmSubscription {
  id         String              @id @default(uuid())
  lawFirm    LawFirm             @relation(fields: [lawFirmId], references: [id])
  lawFirmId  String              @unique

  plan       SubscriptionPlan    @relation(fields: [planId], references: [id])
  planId     String

  status     SubscriptionStatus  @default(TRIAL)
  startedAt  DateTime            @default(now())
  expiresAt  DateTime?

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  invoices   Invoice[]

  @@index([planId])
  @@index([status])
}

// ------------------------------------------------------------
// PHASE 2 — STUDENT LEARNING PLATFORM
// ------------------------------------------------------------

enum ExamType {
  LLB
  BALLB
  BAR_COUNCIL // Nepal Bar Council
  JUDICIAL_SERVICE
  PUBLIC_SERVICE_COMMISSION
  // Loksewa (Nepal civil service) is not one exam — it's several distinct
  // position levels, each with its own syllabus depth. These track which
  // level a question/mock test is prepared for.
  KHARIDAR // Non-Gazetted Third Class
  NAYAB_SUBBA // Non-Gazetted First Class
  SECTION_OFFICER // Gazetted Third Class (Sakha Adhikrit)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Subject {
  id        String    @id @default(uuid())
  name      String
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  examType  ExamType? // Law-specific sub-tag only (LLB/BALLB/...) — null for non-Law courses like IELTS
  createdAt DateTime  @default(now())

  libraryResources LibraryResource[]
  mcqQuestions     McqQuestion[]
  mockTests        MockTest[]
  courseContents   CourseContent[]
  studyProgress    StudyProgress[]
  liveClasses      LiveClass[]
  flashcards       Flashcard[]

  @@unique([name, courseId])
  @@index([courseId])
  @@index([examType])
}

model McqQuestion {
  id            String     @id @default(uuid())
  question      String
  // For MCQ / TRUE_FALSE_NOT_GIVEN / YES_NO_NOT_GIVEN: options hold the
  // answer choices (True/False/Not Given is stored as optionA/B/C so it
  // reuses the exact same select-one UI as a normal MCQ). Null for
  // FILL_BLANK / SHORT_ANSWER, which are graded against correctAnswerText
  // instead.
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption String? // "A" | "B" | "C" | "D" — used by MCQ/TRUE_FALSE_NOT_GIVEN/YES_NO_NOT_GIVEN
  // For FILL_BLANK / SHORT_ANSWER — the expected text answer. Grading does
  // a case-insensitive, trimmed match (IELTS itself accepts minor spelling
  // variants, but exact-ish matching is the practical starting point here).
  correctAnswerText String?
  answerType    McqAnswerType @default(MCQ)
  explanation   String?

  subjectId  String
  subject    Subject    @relation(fields: [subjectId], references: [id])
  courseId   String // denormalized from subject.courseId — lets us filter/gate by course without an extra join
  course     Course     @relation(fields: [courseId], references: [id])
  examType   ExamType? // Law-specific only, null for IELTS/other courses
  difficulty Difficulty @default(MEDIUM)

  // Free-demo gating — see Course model comment for how this works with CourseSubscription.
  isFreeDemo Boolean @default(false)

  // IELTS Listening questions play an audio clip before the question is answerable.
  audioUrl   String?
  sectionType SectionType? // LISTENING | READING | WRITING | SPEAKING — null for non-IELTS-style courses

  createdBy String // Company user id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null = published by TrailBlaze (Company), visible to all subscribers.
  // Set = written by a specific institution's own staff — only that
  // institution's own students see it, even for the same course.
  hostLawFirmId String?
  hostLawFirm   LawFirm? @relation(fields: [hostLawFirmId], references: [id])

  mockTestQuestions MockTestQuestion[]
  testAnswers       TestAnswer[]

  @@index([subjectId])
  @@index([courseId])
  @@index([examType])
  @@index([difficulty])
}

model MockTest {
  id              String   @id @default(uuid())
  title           String
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  examType        ExamType? // Law-specific only, null for IELTS/other courses
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  durationMinutes Int      @default(60)
  isPublished     Boolean  @default(false)
  isFreeDemo      Boolean  @default(false)
  // 0 = no negative marking (Law/IELTS practice style). IOE uses ~10,
  // Medical (MECEE-BL) uses 25 — meaning 25% of a question's own marks are
  // deducted for each wrong (attempted) answer, matching the real exams.
  negativeMarkingPercent Int @default(0)
  // Set when an Institution creates this test (their own students only see
  // it, plus Company's platform-wide tests) — null means Company-created,
  // visible platform-wide. Mirrors McqQuestion.hostLawFirmId.
  hostLawFirmId String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions MockTestQuestion[]
  attempts  TestAttempt[]
  sections  TestSection[]

  @@index([courseId])
  @@index([examType])
  @@index([isPublished])
}

model MockTestQuestion {
  id         String @id @default(uuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String
  question   McqQuestion @relation(fields: [questionId], references: [id])
  sectionId  String? // set when this test uses IELTS-style sections; null for flat Law-style tests
  section    TestSection? @relation(fields: [sectionId], references: [id])
  order      Int
  // Point value of THIS question within THIS specific mock test — lets one
  // test mix question weights (e.g. IOE's Part A = 1 mark, Part B = 2 marks)
  // rather than every question being worth the same.
  marks      Int @default(1)

  @@unique([mockTestId, questionId])
  @@index([mockTestId])
  @@index([sectionId])
}

model TestAttempt {
  id             String    @id @default(uuid())
  studentId      String // User.id (accountType STUDENT)
  student        User      @relation("StudentTestAttempts", fields: [studentId], references: [id])
  mockTestId     String
  mockTest       MockTest  @relation(fields: [mockTestId], references: [id])
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  score          Int?
  totalQuestions Int

  // Anti-cheating: periodic low-res snapshot paths (never continuous
  // video/audio -- keeps storage tiny) taken every few minutes plus on each
  // app-background/foreground transition, and a running count of how many
  // times the student left the test screen (backgrounded the app) during
  // the attempt. flagged is auto-set once appLeftCount crosses a threshold,
  // for a future staff review queue.
  proctoringSnapshotUrls String[] @default([])
  appLeftCount           Int      @default(0)
  flagged                Boolean  @default(false)

  answers TestAnswer[]
  writingSubmissions WritingSubmission[]

  @@index([studentId])
  @@index([mockTestId])
}

model TestAnswer {
  id             String      @id @default(uuid())
  attemptId      String
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       McqQuestion @relation(fields: [questionId], references: [id])
  selectedOption String? // "A" | "B" | "C" | "D" | null (unanswered)
  isCorrect      Boolean?

  @@unique([attemptId, questionId])
}

model Bookmark {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation("StudentBookmarks", fields: [studentId], references: [id])
  resourceType String // "LIBRARY" | "MCQ"
  resourceId   String
  createdAt    DateTime @default(now())

  @@unique([studentId, resourceType, resourceId])
  @@index([studentId])
}

model StudyProgress {
  id               String    @id @default(uuid())
  studentId        String
  student          User      @relation("StudentProgress", fields: [studentId], references: [id])
  subjectId        String
  subject          Subject   @relation(fields: [subjectId], references: [id])
  topicsCompleted  Int       @default(0)
  totalTopics      Int       @default(0)
  lastStudiedAt    DateTime?

  @@unique([studentId, subjectId])
  @@index([studentId])
}

// ------------------------------------------------------------
// PHASE 2 (EXTENDED) — MULTI-COURSE PLATFORM (Law, IELTS, future courses)
// ------------------------------------------------------------

enum CourseCategory {
  LAW
  LANGUAGE // IELTS, TOEFL, etc.
  GOVERNMENT_SERVICE // Loksewa (Nepal civil service exam prep)
  ENGINEERING // IOE entrance and related engineering exam prep
  MEDICAL // MBBS/Medical entrance and related exam prep
  OTHER // future-proofing for whatever comes next
}

model Course {
  id          String         @id @default(uuid())
  name        String // e.g. "Law Exam Preparation", "IELTS Preparation"
  category    CourseCategory
  description String?
  iconUrl     String?
  isActive    Boolean        @default(true)
  // How many days a subscription to this course lasts once granted --
  // access is cut off a day early by the expiry job, so the student's
  // actual last usable day is validityDays - 1.
  validityDays Int           @default(365)
  createdAt   DateTime       @default(now())

  subjects      Subject[]
  liveClasses   LiveClass[]
  subscriptions CourseSubscription[]
  paymentVouchers PaymentVoucher[]
  studentNotes    StudentNote[]
  courseContents  CourseContent[]
  mcqQuestions  McqQuestion[]
  mockTests     MockTest[]
  paymentTransactions PaymentTransaction[]
  flashcards    Flashcard[]
  speakingPrompts SpeakingPrompt[]
  usageLimits UsageLimit[]
  practiceSessions PracticeSession[]
  courseFees CourseFee[]
  studentDiscounts StudentDiscount[]

  @@index([category])
}

// A student's access is per-course, not platform-wide — subscribing to
// IELTS does not unlock Law content and vice versa.
model CourseSubscription {
  id        String    @id @default(uuid())
  studentId String
  student   User      @relation("StudentCourseSubscriptions", fields: [studentId], references: [id])
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// ------------------------------------------------------------
// PAYMENT VOUCHER — student uploads proof of manual payment (bank
// transfer/cash receipt), institution admin approves before course
// access is granted. Separate from the automatic Khalti/eSewa flow.
// ------------------------------------------------------------
enum VoucherStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentVoucher {
  id              String        @id @default(uuid())
  studentId       String
  student         User          @relation("StudentPaymentVouchers", fields: [studentId], references: [id])
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id])
  fileUrl         String
  amount          Float?
  status          VoucherStatus @default(PENDING)
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

// ------------------------------------------------------------
// COURSE CONTENT — study material (PDF/image/text) organized under a
// course and subject, tagged with a free-text "term" label (e.g.
// "Semester 1", "Batch A", whatever the uploader calls their own
// grouping -- deliberately not a hardcoded enum). Company can upload
// content visible to everyone; an institution can additionally upload
// its own content visible only to its own students (lawFirmId set).
// ------------------------------------------------------------
enum ContentFileType {
  PDF
  IMAGE
  TEXT
}

model CourseContent {
  id         String          @id @default(uuid())
  courseId   String
  course     Course          @relation(fields: [courseId], references: [id])
  subjectId  String?
  subject    Subject?        @relation(fields: [subjectId], references: [id])
  lawFirmId  String? // null = Company's own content, visible to all institutions' students on this course
  lawFirm    LawFirm?        @relation(fields: [lawFirmId], references: [id])
  term       String // free-text grouping label, e.g. "Semester 1", "Batch A"
  title      String
  fileType   ContentFileType
  fileUrl    String? // for PDF/IMAGE
  textBody   String? // for TEXT -- stored directly, no file
  uploadedBy String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([courseId])
  @@index([subjectId])
  @@index([lawFirmId])
  @@index([term])
}

// ------------------------------------------------------------
// CASE DEADLINE — statute-of-limitations (हदम्याद), important meeting,
// or filing deadline the lawyer sets manually for a case. A background
// job (same pattern as HearingReminder) sends a notification when it's
// due.
// ------------------------------------------------------------
model CaseDeadline {
  id          String    @id @default(uuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String // e.g. "हदम्याद - रिट निवेदन", "Filing deadline"
  dueAt       DateTime
  remindAt    DateTime // when to send the alert -- may be before dueAt
  sent        Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([caseId])
  @@index([remindAt, sent])
}

// ------------------------------------------------------------
// FIRM PAYMENT TRANSACTION — an institution/law firm paying Company for
// its own platform subscription (FirmSubscription), via eSewa/Khalti/
// manual voucher. Separate from PaymentTransaction, which is a STUDENT
// paying for a COURSE -- different payer, different purpose.
// ------------------------------------------------------------
model FirmPaymentTransaction {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id])
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  gateway         String // ESEWA | KHALTI | MANUAL
  transactionUuid String   @unique
  khaltiPidx      String?
  amount          Float
  status          String   @default("PENDING") // PENDING | COMPLETED | FAILED
  voucherFileUrl  String? // for MANUAL gateway -- uploaded receipt
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lawFirmId])
  @@index([status])
}

// ------------------------------------------------------------
// CASE TASK — project-management-style task a senior lawyer/admin
// assigns to a team member within a case, with a due date and status.
// ------------------------------------------------------------
enum CaseTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model CaseTask {
  id          String         @id @default(uuid())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String
  assignee    User           @relation("CaseTaskAssignee", fields: [assignedTo], references: [id])
  dueDate     DateTime?
  status      CaseTaskStatus @default(PENDING)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([caseId])
  @@index([assignedTo])
}

// ------------------------------------------------------------
// CASE NOTE — internal, confidential notes lawyers/staff leave on a
// case for their own team -- NEVER visible to the client, even though
// the client may have portal access to the same case's documents.
// ------------------------------------------------------------
model CaseNote {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  content   String
  createdBy String
  author    User     @relation("CaseNoteAuthor", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

// ------------------------------------------------------------
// STUDENT NOTES — personal notes a student writes while studying a
// course, for their own reference only (not shared, not gradable).
// ------------------------------------------------------------
model StudentNote {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation("StudentOwnNotes", fields: [studentId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([courseId])
}

// ------------------------------------------------------------
// LIVE CLASSES — Jitsi Meet (free, no per-minute cost)
// ------------------------------------------------------------

model LiveClass {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  title           String
  description     String?
  hostId          String // Company user id (the instructor/staff running it)
  jitsiRoomName   String   @unique // random slug — becomes the Jitsi meeting room name
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  isFreeDemo      Boolean  @default(false)
  status          LiveClassStatus @default(SCHEDULED)
  reminderSent    Boolean  @default(false) // "starting in 10 minutes" push -- set true once sent, never resent
  recordingUrl    String? // uploaded after class ends — subscribed students can watch anytime after
  // Null = hosted directly by TrailBlaze (Company) for all subscribers of
  // the course. Set = hosted by a specific institution's own staff — only
  // that institution's own students (matching lawFirmId) can see/join it,
  // even though other students may also be subscribed to the same course.
  hostLawFirmId   String?
  hostLawFirm     LawFirm? @relation(fields: [hostLawFirmId], references: [id])
  createdAt       DateTime @default(now())

  attendees LiveClassAttendance[]
  feedback  Feedback[]
  cohosts   LiveClassHost[]

  @@index([courseId])
  @@index([scheduledAt])
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveClassAttendance {
  id          String    @id @default(uuid())
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentLiveClassAttendance", fields: [studentId], references: [id])
  joinedAt    DateTime  @default(now())

  @@unique([liveClassId, studentId])
}

// ------------------------------------------------------------
// IELTS-STYLE SECTIONED TESTS (Reading/Listening/Writing/Speaking)
// ------------------------------------------------------------

enum SectionType {
  MCQ // generic multiple-choice section (used by Law tests too)
  READING // passage + questions
  LISTENING // audio + questions
  WRITING // essay/task prompt, graded manually or later by AI
  SPEAKING // prompt + live class booking or recorded audio submission
}

// The answer PATTERN for a question — separate from sectionType (which is
// which skill it belongs to). A Reading question can be MCQ, True/False/Not
// Given, or Fill Blank; a Listening question can be MCQ or Fill Blank, etc.
enum McqAnswerType {
  MCQ // standard 4-option multiple choice
  TRUE_FALSE_NOT_GIVEN // Reading — stored as a 3-option select (A=True, B=False, C=Not Given)
  YES_NO_NOT_GIVEN // Reading — stored as a 3-option select (A=Yes, B=No, C=Not Given)
  FILL_BLANK // free-text answer, graded against correctAnswerText
  SHORT_ANSWER // free-text answer, graded against correctAnswerText
  // Real IELTS Form/Note/Table/Summary/Sentence Completion pattern — ONE
  // shared passage/form/table with MULTIPLE numbered blanks (___1___,
  // ___2___, etc — matched via {{1}}, {{2}} markers in `question`), each
  // graded against its own answer in `correctAnswerText` (pipe-separated,
  // in blank order — e.g. "9am|8pm|student ID").
  MULTI_BLANK
}

// A MockTest can now be composed of multiple typed sections — this is what
// makes the same MockTest model work for both a flat Law MCQ test AND a
// real 4-section IELTS Computer-Delivered-style test.
model TestSection {
  id              String      @id @default(uuid())
  mockTestId      String
  mockTest        MockTest    @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  type            SectionType
  title           String // e.g. "Listening Section 1", "Reading Passage 2", "Writing Task 1"
  passageText     String? // for READING
  audioUrl        String? // for LISTENING
  writingPrompt   String? // for WRITING
  minWordCount    Int? // for WRITING (IELTS Task 1 = 150 words, Task 2 = 250 words)
  timeLimitMinutes Int?
  order           Int

  mockTestQuestions MockTestQuestion[]
  writingSubmissions WritingSubmission[]

  @@index([mockTestId])
}

model WritingSubmission {
  id          String      @id @default(uuid())
  sectionId   String
  section     TestSection @relation(fields: [sectionId], references: [id])
  attemptId   String
  attempt     TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation("StudentWritingSubmissions", fields: [studentId], references: [id])
  essayText   String
  wordCount   Int
  score       Float? // out of 9 (IELTS band score style) — filled in by Company staff review
  feedback    String? // instructor feedback text
  reviewedAt  DateTime?
  submittedAt DateTime    @default(now())

  @@index([attemptId])
  @@index([studentId])
}

// ------------------------------------------------------------
// FEEDBACK — students rate live classes, mock tests, courses
// ------------------------------------------------------------

enum FeedbackTargetType {
  LIVE_CLASS
  MOCK_TEST
  COURSE
}

model Feedback {
  id          String             @id @default(uuid())
  studentId   String
  student     User               @relation("StudentFeedback", fields: [studentId], references: [id])
  targetType  FeedbackTargetType
  targetId    String
  liveClassId String? // set only when targetType = LIVE_CLASS, for the relation below
  liveClass   LiveClass?         @relation(fields: [liveClassId], references: [id])
  rating      Int // 1-5
  comment     String?
  createdAt   DateTime           @default(now())

  @@index([studentId])
  @@index([targetType, targetId])
}

// ------------------------------------------------------------
// PAYMENT — eSewa / Khalti transaction records
// ------------------------------------------------------------

enum PaymentGateway {
  ESEWA
  KHALTI
  MANUAL // cash, bank transfer, or QR-code scan -- recorded by institution staff after the fact
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaymentTransaction {
  id                String         @id @default(uuid())
  studentId         String
  student           User           @relation("StudentPayments", fields: [studentId], references: [id])
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id])
  gateway           PaymentGateway
  transactionUuid   String         @unique // our own reference — eSewa's transaction_uuid, Khalti's purchase_order_id
  khaltiPidx        String?        @unique // Khalti-specific payment identifier, set only for Khalti transactions
  amount            Float
  discountAmount    Float?         // amount deducted via a StudentDiscount, if any -- amount above is what was actually charged/expected after this deduction
  status            PaymentStatus  @default(PENDING)
  paymentMethod     String?        // "CASH" | "BANK_TRANSFER" | "QR_SCAN" -- only meaningful when gateway = MANUAL
  receiptNumber     String?        // institution's own paper/physical receipt number, for manual payments
  recordedBy        String?        // staff userId who manually confirmed this payment (gateway = MANUAL only)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

// ------------------------------------------------------------
// PASSWORD RESET REQUEST — no email service configured yet, so a student
// (or anyone) who forgets their password submits a request here. The
// admin who manages them (Company, or their own institution/law firm
// admin) sees it and manually resets + relays the new password.
// ------------------------------------------------------------

enum PasswordResetRequestStatus {
  PENDING
  RESOLVED
}

model PasswordResetRequest {
  id        String                      @id @default(uuid())
  email     String
  note      String? // optional context from the requester
  status    PasswordResetRequestStatus  @default(PENDING)
  createdAt DateTime                    @default(now())
  resolvedAt DateTime?
  resolvedBy String? // User id of the admin who handled it

  @@index([email])
  @@index([status])
}

// ------------------------------------------------------------
// MCQ PRACTICE ATTEMPT — records every individual question a student
// answers in Practice mode (outside a formal Mock Test), so "My Progress"
// can reflect practice activity, not just mock test scores. Upserted per
// student+question so re-answering the same question updates the record
// rather than piling up duplicates.
// ------------------------------------------------------------

model McqPracticeAttempt {
  id             String   @id @default(uuid())
  studentId      String
  questionId     String
  isCorrect      Boolean
  // The option/text the student actually chose -- lets "Review Mistakes"
  // show what they answered, not just the answer key. Nullable because
  // rows created before this field existed have no value.
  selectedOption String?
  answeredAt     DateTime @default(now())

  @@unique([studentId, questionId])
  @@index([studentId])
}

// ------------------------------------------------------------
// FLASHCARD — a generic "term + definition" reference card, reused across
// every sector rather than being IELTS-vocabulary-specific: IELTS gets
// vocabulary words, Law gets legal terms, IOE/Medical get formulas or key
// facts, Loksewa gets GK facts. The label shown to students is decided by
// the frontend based on the course, not by this model.
// ------------------------------------------------------------

model Flashcard {
  id            String   @id @default(uuid())
  term          String // the word / legal term / formula name / fact title
  definition    String // meaning / legal definition / formula or explanation
  example       String? // optional example sentence or worked example
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id])
  difficulty    Difficulty @default(MEDIUM)
  hostLawFirmId String? // set when an institution created it — their own students only, mirrors McqQuestion

  createdBy String
  createdAt DateTime @default(now())

  progress FlashcardProgress[]

  @@index([courseId])
  @@index([hostLawFirmId])
}

// Tracks each student's own familiarity with a card — a simple three-state
// "again / good / easy" self-rating rather than a full spaced-repetition
// scheduler, so cards the student already knows well surface less often
// without needing a background job to recompute review dates.
enum FlashcardFamiliarity {
  AGAIN
  GOOD
  EASY
}

model FlashcardProgress {
  id          String               @id @default(uuid())
  studentId   String
  flashcardId String
  flashcard   Flashcard            @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  familiarity FlashcardFamiliarity
  reviewedAt  DateTime             @default(now())

  @@unique([studentId, flashcardId])
  @@index([studentId])
}


// ------------------------------------------------------------
// PRECEDENT (नजिर) — Supreme Court / High Court judgment database.
// Separate from LibraryResource (which holds Acts/Regulations) since
// precedents have their own structured metadata (court, judges, parties,
// case type) and are searched differently — full-text across the entire
// judgment body, not just title/category.
//
// hostLawFirmId mirrors the LibraryResource/McqQuestion pattern: null =
// company-wide (visible to any institution once granted the
// "precedent_search" module), set = that institution's own upload,
// visible only to them.
// ------------------------------------------------------------

model Precedent {
  id             String   @id @default(uuid())
  sourceId       String?  @unique // original nkp.gov.np numeric id -- makes re-import idempotent (upsert by this, never duplicates)
  sourceUrl      String?

  title          String // e.g. "निर्णय नं. ९१०० - उत्प्रेषण"
  caseType       String? // the "मुद्दाः" field as scraped, e.g. "उत्प्रेषण" -- kept as-is even though format is inconsistent
  category       String? // auto-detected broad category (Criminal, Family/Property, Constitutional, Civil, Land, Tax, Labor, Court Procedure) -- this is what lawyers filter by

  court          String? // e.g. "सर्वोच्च अदालत"
  benchType      String? // e.g. "विशेष इजलास"
  judges         String? // comma-joined judge names as extracted
  decisionDate   String? // as scraped (Bikram Sambat format varies) -- kept as text, not a real Date, since BS dates aren't directly convertible
  caseNumber     String? // रिट/मुद्दा नं.
  petitioner     String? // निवेदक
  respondent     String? // विपक्षी

  fullContent    String // the entire scraped judgment text -- always populated even if the structured fields above failed to extract, so nothing is ever unsearchable

  hostLawFirmId  String? // null = company-wide; set = this institution's own upload
  uploadedBy     String
  createdAt      DateTime @default(now())

  // Generated column (added via raw SQL migration, not managed by Prisma) --
  // declaring it as Unsupported tells Prisma "this column exists, don't
  // try to add/drop/alter it" so `db push`/`migrate dev` never touches it.
  searchVector   Unsupported("tsvector")?

  @@index([category])
  @@index([caseType])
  @@index([hostLawFirmId])
}

// ------------------------------------------------------------
// USER PERMISSION — individual override on top of role-based
// permissions. Real-world need: two staff can share the same role
// (e.g. "Librarian"), but one of them personally needs one extra
// permission the role doesn't grant, or needs one role-permission
// specifically taken away from them — without creating a whole new
// role just for one person.
//
// granted: true  = explicit GRANT, gives this permission even if the
//                   user's role doesn't include it
// granted: false = explicit REVOKE, takes this permission away even
//                   if the user's role does include it
//
// An explicit row here always wins over the role's default — this
// mirrors how most real RBAC systems (AWS IAM, Django) handle
// individual-over-group overrides. No row for a given permission
// means "no override, just use whatever the role says" (today's
// behavior, unchanged).
//
// Works for ANY account type that has a User row and a roleId —
// Company staff, tenant (Law Firm/Institution) staff, and students
// alike, since this is keyed on userId + permissionId generically.
// ------------------------------------------------------------

model UserPermission {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  granted      Boolean // true = extra grant beyond the role, false = revoke despite the role
  grantedBy    String // userId of whoever set this override, for audit purposes
  reason       String? // optional note on why this individual override exists
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
}

// ------------------------------------------------------------
// IELTS SPEAKING MODULE
// ------------------------------------------------------------
// Built as a standalone framework first — recording, storage, and
// submission tracking all work today with zero AI cost. Every AI-grading
// field below is nullable, so a submission simply sits at
// PENDING_GRADING until the company decides to pay for and wire up an
// actual grading pipeline (speech-to-text + LLM scoring) later. Nothing
// here needs to change when that happens — just fill these fields in
// from whatever grading job runs.

model SpeakingPrompt {
  id               String   @id @default(uuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  part             Int // 1, 2, or 3 -- matches real IELTS Speaking structure
  title            String // e.g. "Describe a memorable trip"
  promptText       String // the full question or cue-card text
  prepTimeSeconds  Int? // Part 2 cue cards get ~1 min prep; Part 1/3 usually none
  speakTimeSeconds Int // how long the student is expected to speak
  isPublished      Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())

  submissions SpeakingSubmission[]

  @@index([courseId])
}

enum SpeakingSubmissionStatus {
  PENDING_GRADING // recording uploaded, no AI grading run yet (today's default -- and forever, until AI is wired up)
  GRADED
  GRADING_FAILED // AI pipeline attempted and errored -- kept separate from PENDING so it's visible for retry, not silently stuck
}

model SpeakingSubmission {
  id              String   @id @default(uuid())
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  prompt          SpeakingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptId        String

  recordingUrl    String // path to the stored video/audio file (local disk today, swappable to cloud storage later without schema change)
  recordingType   String // "video" | "audio" -- camera+mic vs mic-only submission
  durationSeconds Int?

  status          SpeakingSubmissionStatus @default(PENDING_GRADING)

  // Everything below stays null until a real grading pipeline exists.
  transcript          String? // filled in by speech-to-text once that's wired up
  fluencyScore         Float? // IELTS band-style sub-scores (0-9 scale)
  lexicalScore          Float?
  grammarScore          Float?
  pronunciationScore    Float?
  overallBand           Float?
  aiFeedback             String? // qualitative written feedback from the grading model
  gradedAt               DateTime?

  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([promptId])
  @@index([status])
}
// ------------------------------------------------------------
// USAGE LIMITS — dynamic, per-course caps on Practice / Mock Test /
// Speaking attempts. Company sets a default (lawFirmId = null, applies to
// direct/non-institution students). An institution can set its own limit
// for the same course (lawFirmId = their own id) — their students use
// THIS row instead of Company's default, since an institution's own
// policy (set during in-person counseling, per the real-world use case
// described) should govern its own students.
//
// null on any limit field = unlimited for that module.
// ------------------------------------------------------------

model UsageLimit {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lawFirmId     String? // null = Company's default (for direct students); set = this institution's own policy for their students
  lawFirm       LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  practiceLimit Int? // total practice sessions allowed for this course (lifetime of the subscription) -- null = unlimited
  mockTestLimit Int? // total mock test attempts allowed
  speakingLimit Int? // total speaking test submissions allowed

  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([courseId, lawFirmId])
  @@index([courseId])
}

// ------------------------------------------------------------
// PRACTICE SESSION — the one usage-tracking model that didn't already
// exist. Mock Test already has TestAttempt, Speaking already has
// SpeakingSubmission -- both are reused as-is for counting "how many
// times has this student used this module for this course", this model
// fills the same role for Practice (MCQ solving), which previously had
// no session/attempt boundary at all.
// ------------------------------------------------------------

model PracticeSession {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())

  @@index([studentId])
  @@index([courseId])
}

// ------------------------------------------------------------
// INVOICE — real-world billing for law firm/institution subscriptions.
// There is no payment gateway integration for firm-level billing (same
// as FirmSubscription's existing design note) -- Company staff manually
// create an invoice, mark it paid once payment is confirmed out-of-band
// (bank transfer, cash, eSewa/Khalti QR shown in person, etc.), and this
// becomes the paper trail / receipt history for that firm.
// ------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                 String            @id @default(uuid())
  invoiceNumber      String            @unique // e.g. "INV-2026-0001", sequential per year
  lawFirmId          String
  lawFirm            LawFirm           @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       FirmSubscription? @relation(fields: [subscriptionId], references: [id])
  amount             Float // NPR
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status             InvoiceStatus     @default(PENDING)
  paymentMethod      String? // "Bank Transfer" | "Cash" | "eSewa" | "Khalti" | "Cheque" -- free text, manually entered
  paymentReference   String? // transaction id / cheque no. / bank reference, for the paper trail
  paidAt             DateTime?
  notes              String?
  createdBy          String // Company user id who created/issued this invoice
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([lawFirmId])
  @@index([status])
}

// ------------------------------------------------------------
// LIVE CLASS HOST — supports assigning 2+ teachers to the same live
// class (co-teaching). The original `hostId` field on LiveClass stays
// as-is for backward compatibility (existing code reading "the" host
// keeps working) -- this join table adds the FULL list of co-hosts,
// which always includes the original hostId (marked isPrimary: true)
// plus any additional teachers assigned afterward.
// ------------------------------------------------------------

model LiveClassHost {
  id          String    @id @default(uuid())
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  liveClassId String
  host        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId      String
  isPrimary   Boolean   @default(false) // the class's original/main host
  createdAt   DateTime  @default(now())

  @@unique([liveClassId, hostId])
  @@index([liveClassId])
  @@index([hostId])
}

// ------------------------------------------------------------
// INSTITUTION FEE MANAGEMENT — course fee per institution, per-student
// discounts, and manual/QR payment recording. Real-world pattern: an
// institution sets its own fee for a course, can grant individual
// students a discount (scholarship, sibling discount, referral, etc.),
// and records payments made outside a card/wallet gateway (cash, bank
// transfer, or QR-code scan) by hand once the money has actually arrived.
// ------------------------------------------------------------

model CourseFee {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lawFirmId  String? // null = Company's own price for direct students; set = this institution's own price for their students
  lawFirm    LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  amount     Float // NPR
  updatedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
  @@index([lawFirmId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model StudentDiscount {
  id          String       @id @default(uuid())
  studentId   String
  student     User         @relation("StudentDiscounts", fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        DiscountType
  value       Float // percentage (0-100) if PERCENTAGE, or NPR amount if FIXED_AMOUNT
  reason      String? // "Sibling discount", "Merit scholarship", "Staff referral", etc.
  grantedBy   String
  createdAt   DateTime     @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// ------------------------------------------------------------
// STAFF SALARY & PAYMENT — the "expense" side of institution accounting,
// mirroring the student-fee "revenue" side but in reverse (institution
// pays staff, rather than students paying the institution). Categorized
// by role (Teacher, Admin, Support, etc.) since real-world coaching
// institutes pay these differently -- fixed monthly for most staff,
// per-class/hourly for visiting or part-time teachers.
// ------------------------------------------------------------

enum SalaryType {
  FIXED_MONTHLY
  PER_CLASS
  HOURLY
}

model StaffSalary {
  id         String     @id @default(uuid())
  staffId    String
  staff      User       @relation("StaffSalaryRecord", fields: [staffId], references: [id], onDelete: Cascade)
  lawFirmId  String // which institution this staff member's salary record belongs to
  lawFirm    LawFirm    @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  category   String // "Teacher", "Admin", "Support", etc. -- free text so each institution can use its own labels
  salaryType SalaryType
  amount     Float // NPR -- monthly amount if FIXED_MONTHLY, per-class or per-hour rate otherwise
  updatedBy  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  payments StaffPayment[]

  @@unique([staffId, lawFirmId])
  @@index([lawFirmId])
}

model StaffPayment {
  id            String      @id @default(uuid())
  staffSalary   StaffSalary @relation(fields: [staffSalaryId], references: [id], onDelete: Cascade)
  staffSalaryId String
  amount        Float // NPR -- actual amount paid this time (may differ from the salary record if hourly/per-class)
  paidForPeriod String? // e.g. "2026-08" for a monthly salary, or a date range description for hourly/per-class pay
  paymentMethod String // "CASH" | "BANK_TRANSFER" | "QR_SCAN"
  receiptNumber String?
  recordedBy    String
  createdAt     DateTime    @default(now())

  @@index([staffSalaryId])
}

// ------------------------------------------------------------
// EMAIL VERIFICATION CODE — automated 6-digit code sent via email
// (Gmail SMTP), used for both registration email verification and
// password reset. Separate from PasswordResetRequest (the older manual
// admin-ticket flow) -- that stays as a fallback for someone who's
// entirely lost access to their email; this is the normal automated path.
// ------------------------------------------------------------

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model EmailVerificationCode {
  id        String              @id @default(uuid())
  email     String
  code      String // 6-digit code
  purpose   VerificationPurpose
  expiresAt DateTime // codes are short-lived (e.g. 10 minutes)
  usedAt    DateTime? // null = not yet used; set once consumed, so a code can't be replayed
  createdAt DateTime            @default(now())

  @@index([email, purpose])
}


// ------------------------------------------------------------
// MESSAGING (real user-to-user chat -- Lawyer<->Client,
// Institution/Teacher<->Student, Institution/LawFirm<->Company)
// ------------------------------------------------------------

model Conversation {
  id              String    @id @default(uuid())
  userAId         String
  userA           User      @relation("ConversationAsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId         String
  userB           User      @relation("ConversationAsUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime?
  lastMessageText String?
  createdAt       DateTime  @default(now())

  messages        Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  attachmentUrl  String?
  attachmentType String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}


// ------------------------------------------------------------
// SUPPORT TICKETS (async Institution/LawFirm <-> Company support,
// replacing real-time chat for this one relationship)
// ------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id             String        @id @default(uuid())
  lawFirmId      String
  lawFirm        LawFirm       @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User          @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  subject        String
  description    String
  attachmentUrl  String?
  attachmentType String?
  status         TicketStatus  @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  comments    TicketComment[]

  @@index([lawFirmId])
  @@index([status])
}

model TicketComment {
  id             String        @id @default(uuid())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId       String
  authorId       String
  author         User          @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
}
